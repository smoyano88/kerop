// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id              String         @id @default(uuid())
  groupNumber     Int?           @unique
  type            String
  date            DateTime
  ageRange        String
  drinksAvailable String
  spotsPerGender  Int            @default(8)
  price           Int            @default(850)
  mpEnabled       Boolean        @default(true)
  registrations   Registration[]
  matchData       MatchData?
  createdAt       DateTime       @default(now())
}

model Registration {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  gender          String
  email           String?
  phone           String?
  instagram       String?
  selectedDrink   String
  eventId         String?
  archivedEventId String?  // Se llena al eliminar el evento para preservar agrupación
  eventType       String?
  eventDate       DateTime?
  paid            Boolean  @default(false)
  attended        Boolean  @default(false)
  paymentMethod   String?
  paymentId       String?
  event           Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Drink {
  id          String   @id @default(uuid())
  name        String   @unique
  isAlcoholic Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Tatuador {
  id           String            @id @default(uuid())
  name         String
  specialty    String
  bio          String            @default("")
  phone        String
  instagram    String            @default("")
  photoUrl     String            @default("")
  gallery      Json              @default("[]")
  order        Int               @default(0)
  active       Boolean           @default(true)
  contacts     TatuadorContact[]
  createdAt    DateTime          @default(now())
}

model TatuadorContact {
  id          String    @id @default(uuid())
  tatuadorId  String
  tatuador    Tatuador  @relation(fields: [tatuadorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

model MenuItem {
  id          String   @id @default(uuid())
  category    String   // "cafe" | "comida" | "tragos"
  name        String
  description String   @default("")
  price       Int      // en pesos uruguayos
  imageUrl    String   @default("")
  available   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model MatchData {
  id              String   @id @default(uuid())
  eventId         String?  @unique
  archivedEventId String?  // Se llena al eliminar el evento para preservar agrupación
  event           Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  // JSON: { "regId1": ["regId3", "regId5"], "regId2": ["regId1"] }
  // Cada key = participante, array = los que marcó como "me gustó"
  selections Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
