# ── Base de datos (Neon PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── MercadoPago ───────────────────────────────────────────────────────────────
# Obtené tus credenciales en: https://www.mercadopago.com/developers/panel/credentials
# Para producción: usá las credenciales de la pestaña "Productivas"
# Para pruebas:    usá las credenciales de la pestaña "Prueba"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_ENV="sandbox"

# ── URL pública (para back_urls y webhook de MercadoPago) ────────────────────
# En producción: el dominio real (ej: https://kerop.uy)
# En desarrollo: usá un túnel como serveo o ngrok apuntando a localhost:3000
#   serveo:  ssh -R 80:localhost:3000 serveo.net
#   ngrok:   ngrok http 3000
NEXT_PUBLIC_BASE_URL="https://tu-tunnel.serveousercontent.com"
