# ── Base de datos (Neon PostgreSQL) ──────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── MercadoPago ───────────────────────────────────────────────────────────────
# Obtené tus credenciales en: https://www.mercadopago.com/developers/panel/credentials
# Para producción: usá las credenciales de la pestaña "Productivas"
# Para pruebas:    usá las credenciales de la pestaña "Prueba"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_ENV="sandbox"

# ── URL pública (para back_urls y webhook de MercadoPago) ────────────────────
# En producción: el dominio real (ej: https://kerop.uy)
# En desarrollo: usá un túnel como serveo o ngrok apuntando a localhost:3000
#   serveo:  ssh -R 80:localhost:3000 serveo.net
#   ngrok:   ngrok http 3000
NEXT_PUBLIC_BASE_URL="https://tu-tunnel.serveousercontent.com"

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Usá tu cuenta Gmail y una Contraseña de Aplicación (16 chars, NO tu pass normal)
# Cómo generarla:
# 1. Activá la verificación en 2 pasos en tu cuenta de Google
# 2. Ve a: myaccount.google.com → Seguridad → Contraseñas de aplicaciones
# 3. Creá una nueva para "Correo" en "Otro dispositivo"
# 4. Copiá los 16 caracteres generados (sin espacios) como SMTP_PASS
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="abcdabcdabcdabcd"

# ── WhatsApp (Green API - Gratis y Confiable) ─────────────────────────────────
# 1. Creá una cuenta gratis en: console.green-api.com
# 2. Creá una instancia (Plan Developer - Gratis)
# 3. Escaneá el código QR con tu WhatsApp (como si fuera WhatsApp Web)
# 4. Copiá el idInstance y apiTokenInstance de la consola y pegalos acá:
# Nota: La instancia Developer gratuita permite enviar mensajes, imágenes, etc.
# Límite: Solo podés interactuar con 3 números distintos al mes en el plan gratis.
GREEN_API_ID_INSTANCE="TU_ID_INSTANCE"
GREEN_API_TOKEN_INSTANCE="TU_API_TOKEN"

# ── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Generá las keys UNA SOLA VEZ con: npx web-push generate-vapid-keys
# La clave pública va también en el frontend (prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BEjEmplo_clave_publica_vapid_aqui..."
VAPID_PRIVATE_KEY="ejemplo_clave_privada_vapid_aqui..."
